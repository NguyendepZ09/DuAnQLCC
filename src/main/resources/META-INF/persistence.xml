<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="QLCCUnit" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Registered JPA Entities -->
        <class>entity.TaiKhoan</class>
        <class>entity.CuDan</class>
        <class>entity.NhanVien</class>
        <class>entity.CanHo</class>
        <class>entity.HoaDon</class>
        <class>entity.ThongBao</class>
        <class>entity.BinhChon</class>
        <class>entity.PhuongAnBinhChon</class>
        <class>entity.PhanAnhSuCo</class>
        <class>entity.LichSuXuLySuCo</class>
        <class>entity.PhieuBau</class>
        <class>entity.ThongBaoDaDoc</class>
        <class>entity.ChiTietHoaDon</class>
        <class>entity.ChiSoTieuThu</class>
        <class>entity.ChamCong</class>
        <class>entity.NhatKyCaTruc</class>
        <class>entity.NhatKyTuanTra</class>
        <class>entity.QuanLyXe</class>
        <class>entity.TheTu</class>
        <class>entity.DanhMucTienIch</class>
        <class>entity.DatLichTienIch</class>
        <class>entity.DanhMucBoPhan</class>
        <class>entity.DanhMucVaiTro</class>
        <class>entity.BieuGiaDichVu</class>
        <class>entity.GiaoDichThanhToan</class>

        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="com.microsoft.sqlserver.jdbc.SQLServerDriver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:sqlserver://localhost:1433;databaseName=QLCCNew2;encrypt=false;trustServerCertificate=true;sendStringParametersAsUnicode=true"/>
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value="123456"/>

            <property name="hibernate.dialect" value="org.hibernate.dialect.SQLServerDialect"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
